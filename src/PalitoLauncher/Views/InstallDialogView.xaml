<UserControl x:Class="PalitoLauncher.Views.InstallDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Border Width="580" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="26,24,26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource DimText}" Margin="0,4,0,0" />

            <TextBlock Text="Carpeta de instalación" Margin="0,20,0,6" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Text="{Binding PickedFolder, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsConfirming}"
                         AutomationProperties.Name="Carpeta de instalación" />
                <Button x:Name="ChangeButton" Grid.Column="1" Margin="8,0,0,0" Content="Cambiar…"
                        Command="{Binding ChangeFolderCommand}" AutomationProperties.Name="Cambiar carpeta" />
            </Grid>

            <TextBlock Text="{Binding ResolvedPathText}" Style="{StaticResource DimText}" Margin="0,10,0,0"
                       Visibility="{Binding ResolvedPathText, Converter={StaticResource NullToVis}}" />

            <TextBlock Text="{Binding SpaceText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                       Visibility="{Binding SpaceText, Converter={StaticResource NullToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSpaceInsufficient}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Margin="0,12,0,0" CornerRadius="8" Padding="12,9" BorderThickness="1"
                    Visibility="{Binding HasLocationMessage, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1A5AA9FF" />
                        <Setter Property="BorderBrush" Value="#405AA9FF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocationWarning}" Value="True">
                                <Setter Property="Background" Value="#1AFFB020" />
                                <Setter Property="BorderBrush" Value="#55FFB020" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLocationBlocked}" Value="True">
                                <Setter Property="Background" Value="#1AFF5C6C" />
                                <Setter Property="BorderBrush" Value="#55FF5C6C" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding LocationMessage}" FontSize="13" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocationWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLocationBlocked}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <CheckBox Margin="0,18,0,0" Content="Crear acceso directo en el escritorio" IsChecked="{Binding CreateDesktopShortcut}"
                      IsEnabled="{Binding IsConfirming, Converter={StaticResource InverseBool}}"
                      Visibility="{Binding ShowShortcutOption, Converter={StaticResource BoolToVis}}" />

            <DockPanel Margin="0,24,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Comprobando…" Style="{StaticResource DimText}" VerticalAlignment="Center"
                           Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                <Button x:Name="PrimaryButton" DockPanel.Dock="Right" MinWidth="120" Margin="10,0,0,0"
                        Style="{StaticResource AccentButton}" Content="Instalar" Command="{Binding InstallCommand}" />
                <Button x:Name="SecondaryButton" DockPanel.Dock="Right" MinWidth="100" Content="Cancelar"
                        Command="{Binding CancelCommand}" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
