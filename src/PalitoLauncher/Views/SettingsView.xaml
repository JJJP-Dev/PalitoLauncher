<UserControl x:Class="PalitoLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="SettingsDangerButton" TargetType="Button" BasedOn="{StaticResource DangerOutlineButton}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="40,30,40,32" MaxWidth="860" HorizontalAlignment="Stretch">
            <TextBlock Text="Ajustes" Style="{StaticResource PageTitleText}" />

            <!-- Instalación -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Instalación" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding InstallPathText}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding InstallSizeText}" Style="{StaticResource DimText}" Margin="0,2,0,0"
                               Visibility="{Binding InstallSizeText, Converter={StaticResource NullToVis}}" />
                    <WrapPanel Margin="0,14,0,0">
                        <!-- Unidad no disponible: salidas reales (nunca se instala en otro sitio sin elegirlo) -->
                        <Button Style="{StaticResource SettingsButton}" Content="Elegir otra carpeta…" Command="{Binding ChooseAnotherFolderCommand}"
                                ToolTip="Instalar el juego en otra carpeta"
                                Visibility="{Binding IsDriveMissing, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource SettingsButton}" Content="Olvidar esta carpeta" Command="{Binding ForgetInstallFolderCommand}"
                                ToolTip="Dejar de usar esta carpeta (no se borra nada)"
                                Visibility="{Binding IsDriveMissing, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource SettingsButton}" Content="Abrir carpeta" Command="{Binding OpenInstallFolderCommand}" />
                        <Button Style="{StaticResource SettingsButton}" Content="Mover…" Command="{Binding MoveInstallCommand}" />
                        <Button Style="{StaticResource SettingsDangerButton}" Content="Desinstalar" Command="{Binding UninstallCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Actualizaciones -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Actualizaciones" Style="{StaticResource SectionTitleText}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                              Content="Descargar e instalar automáticamente" IsChecked="{Binding AutoDownloadUpdates}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                              Content="Incluir versiones de prueba (pre-release)" IsChecked="{Binding IncludePrereleases}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                              Content="Buscar actualizaciones del launcher" IsChecked="{Binding CheckLauncherUpdates}" />
                    <Button Style="{StaticResource SettingsButton}" Content="Buscar ahora" Command="{Binding CheckNowCommand}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- Descargas -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Descargas" Style="{StaticResource SectionTitleText}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Límite de velocidad" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding SpeedLimitOptions}"
                                  SelectedItem="{Binding SelectedSpeedLimit}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="Límite de velocidad" />
                    </Grid>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                              Content="Conservar archivos descargados" IsChecked="{Binding KeepDownloadedArchives}" />
                    <TextBlock Text="Ocupan espacio, pero permiten reinstalar sin volver a descargar." Style="{StaticResource DimText}"
                               Margin="0,4,58,0" />
                    <Button Style="{StaticResource SettingsButton}" Content="Borrar descargas pendientes" Command="{Binding ClearDownloadsCommand}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- Juego -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Juego" Style="{StaticResource SectionTitleText}" />
                    <!-- Perfil de lanzamiento (se combina con los argumentos de abajo, que mandan) -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Modo de pantalla" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="240" ItemsSource="{Binding LaunchProfileOptions}"
                                  SelectedItem="{Binding SelectedLaunchProfile}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="Modo de pantalla" />
                    </Grid>
                    <TextBlock Text="Cómo se abre el juego: en ventana, a pantalla completa… «Lo que diga el juego» usa la configuración del propio juego."
                               Style="{StaticResource DimText}" Margin="0,4,0,0" />
                    <TextBlock Text="Argumentos de lanzamiento" Style="{StaticResource BodyText}" Margin="0,16,0,6" />
                    <TextBox x:Name="LaunchArgumentsBox" Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}"
                             LostKeyboardFocus="LaunchArgumentsBox_LostKeyboardFocus"
                             AutomationProperties.Name="Argumentos de lanzamiento" />
                    <TextBlock Text="Opcional, para usuarios avanzados. Se añaden después del modo de pantalla y mandan sobre él. Ejemplo: -screen-width 1600 -screen-height 900"
                               Style="{StaticResource DimText}" Margin="0,4,0,0" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Al abrir el juego" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding AfterLaunchOptions}"
                                  SelectedItem="{Binding SelectedAfterLaunch}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="Al abrir el juego" />
                    </Grid>

                    <!-- Sesiones de prueba (launcher.json) -->
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,16,0,0"
                              Content="Avisarme antes de las sesiones de prueba" IsChecked="{Binding PlaytestRemindersEnabled}" />
                    <TextBlock Text="Si el launcher está abierto, te avisa con una notificación de Windows 15 minutos antes de que empiece una sesión."
                               Style="{StaticResource DimText}" Margin="0,4,58,0" />

                    <!-- Misiones de prueba (missions.json) -->
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,16,0,0"
                              Content="Mostrar las misiones de prueba" IsChecked="{Binding ShowMissions}" />
                    <TextBlock Text="Retos opcionales para los playtests en Inicio. Lo que consigues en el juego se marca solo y el resultado le llega al equipo."
                               Style="{StaticResource DimText}" Margin="0,4,58,0" />
                    <Grid Margin="0,10,0,0" Visibility="{Binding HasPendingMissions, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphText}">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Text" Value="&#xE896;" />
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingMissionsWaitForTeam}" Value="True">
                                            <Setter Property="Text" Value="&#xE946;" />
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding PendingMissionsText}" FontSize="13" VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingMissionsWaitForTeam}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="2" Style="{StaticResource SettingsButton}" Margin="12,0,0,0" Content="Enviar ahora"
                                Command="{Binding SendMissionResultsCommand}" />
                    </Grid>

                    <!-- Opiniones -->
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,0" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,16,0,0"
                              Content="Pedirme opinión al cerrar el juego" IsChecked="{Binding AskFeedbackAfterSession}" />
                    <TextBlock Text="Tras una partida de unos minutos aparece una pequeña encuesta opcional (como mucho una vez cada pocas horas)."
                               Style="{StaticResource DimText}" Margin="0,4,58,0" />
                    <TextBlock Text="Tu nombre en Discord (opcional)" Style="{StaticResource BodyText}" Margin="0,16,0,6" />
                    <TextBox x:Name="FeedbackNicknameBox" Text="{Binding FeedbackNickname, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="{Binding NicknameMaxLength, Mode=OneWay}" Width="360" HorizontalAlignment="Left"
                             LostKeyboardFocus="FeedbackNicknameBox_LostKeyboardFocus"
                             AutomationProperties.Name="Tu nombre en Discord (opcional)" />
                    <TextBlock Text="Pon el mismo nombre que usas en Discord: así el equipo sabe de quién es cada opinión, reporte o resultado de las misiones. Déjalo vacío para enviarlos de forma anónima."
                               Style="{StaticResource DimText}" Margin="0,4,0,0" />
                    <Grid Margin="0,14,0,0" Visibility="{Binding HasPendingFeedback, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Sin webhook (esperan al equipo) no es un problema: icono de información y color neutro -->
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphText}">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Text" Value="&#xE896;" />
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingFeedbackWaitsForTeam}" Value="True">
                                            <Setter Property="Text" Value="&#xE946;" />
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding PendingFeedbackText}" FontSize="13" VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingFeedbackWaitsForTeam}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="2" Style="{StaticResource SettingsButton}" Margin="12,0,0,0" Content="Reintentar envío"
                                Command="{Binding RetryFeedbackSendCommand}" />
                    </Grid>
                    <!-- Reportes de problemas pendientes (misma presentación que las opiniones) -->
                    <Grid Margin="0,14,0,0" Visibility="{Binding HasPendingBugReports, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphText}">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Text" Value="&#xE896;" />
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingBugReportsWaitForTeam}" Value="True">
                                            <Setter Property="Text" Value="&#xE946;" />
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding PendingBugReportsText}" FontSize="13" VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingBugReportsWaitForTeam}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="2" Style="{StaticResource SettingsButton}" Margin="12,0,0,0" Content="Reintentar envío"
                                Command="{Binding RetryBugReportSendCommand}" AutomationProperties.Name="Reintentar envío de los reportes" />
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource SettingsButton}" Command="{Binding SendFeedbackCommand}" AutomationProperties.Name="Enviar opinión">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE939;" Style="{StaticResource GlyphText}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Enviar opinión" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsButton}" Command="{Binding ReportProblemCommand}" AutomationProperties.Name="Reportar un problema">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEBE8;" Style="{StaticResource GlyphText}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Reportar un problema" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsButton}" Command="{Binding ShowHostingCommand}" AutomationProperties.Name="Hostear partida: mi IP">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" Style="{StaticResource GlyphText}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Hostear partida: mi IP" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Herramientas de desarrollo -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Herramientas de desarrollo" Style="{StaticResource SectionTitleText}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                              Content="Modo desarrollador" IsChecked="{Binding DeveloperMode}" />
                    <TextBlock Text="Muestra herramientas para probar el juego, como abrir varias ventanas del juego a la vez. No hace falta para jugar."
                               Style="{StaticResource DimText}" Margin="0,4,58,0" />
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding DeveloperMode, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Command="{Binding LaunchExtraInstanceCommand}"
                                AutomationProperties.Name="Abrir otra instancia del juego">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource GlyphText}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Abrir otra instancia del juego" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource DimText}" Margin="0,0,58,0"
                                   Text="Útil para probar host y cliente en tu PC (se abre con el mismo modo de pantalla y argumentos). Si el juego tiene «Force Single Instance» activado en Unity, no se abrirá otra ventana. También está junto a JUGAR y en el menú ⋯." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Launcher -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Launcher" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding LauncherVersionText}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding SelfUpdateNote}" Style="{StaticResource DimText}" Margin="0,2,0,0"
                               Visibility="{Binding SelfUpdateNote, Converter={StaticResource NullToVis}}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource SettingsButton}" Content="Crear acceso directo en el escritorio"
                                Command="{Binding CreateDesktopShortcutCommand}" />
                        <Button Style="{StaticResource SettingsButton}" Content="Abrir carpeta de logs" Command="{Binding OpenLogsFolderCommand}" />
                        <Button Style="{StaticResource SettingsButton}" Content="Crear informe para el desarrollador"
                                Command="{Binding CreateReportCommand}" />
                        <Button Style="{StaticResource SettingsButton}" Content="Ver launcher en GitHub" Command="{Binding OpenLauncherGitHubCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
