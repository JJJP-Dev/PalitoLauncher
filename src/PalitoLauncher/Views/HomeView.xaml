<UserControl x:Class="PalitoLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PalitoLauncher.ViewModels"
             xmlns:views="clr-namespace:PalitoLauncher.Views"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="40,30,40,28" MaxWidth="980" HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding GameName}" FontSize="46" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Instala, actualiza y juega con tus amigos." Style="{StaticResource DimText}" FontSize="14" Margin="2,2,0,0" />
                    <!-- Enlaces de comunidad (launcher.json) -->
                    <ItemsControl ItemsSource="{Binding CommunityLinks}" Margin="0,12,0,0" Focusable="False" IsTabStop="False"
                                  Visibility="{Binding HasCommunityLinks, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CommunityLinkViewModel}">
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="10,6" Command="{Binding OpenCommand}"
                                        ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Label}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource GlyphText}" FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- Enviar opinión: siempre disponible (aunque el juego no esté instalado) -->
                <Button Grid.Column="1" VerticalAlignment="Top" Margin="16,14,0,0" Command="{Binding SendFeedbackCommand}"
                        ToolTip="Cuéntale al equipo qué te parece el juego" AutomationProperties.Name="Enviar opinión">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE939;" Style="{StaticResource GlyphText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Enviar opinión" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Chips -->
            <WrapPanel Margin="0,18,0,0">
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphText}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding InstalledVersionText}" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Visibility="{Binding HasLatest, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource GlyphText}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LatestVersionText}" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge}" Background="{StaticResource AccentBrush}"
                                Visibility="{Binding IsLatestNew, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nuevo" Style="{StaticResource BadgeText}" Foreground="{StaticResource OnAccentBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" BorderBrush="#55FFB020" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource GlyphText}" FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding OfflineChipText}" FontSize="13" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Próxima sesión de prueba (launcher.json) -->
            <views:PlaytestCard Margin="0,16,0,0" DataContext="{Binding Playtest}"
                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />

            <!-- Novedades de la última versión, o «Qué ha cambiado desde tu versión» si te has saltado 2 o más -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasLatest, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver en GitHub" Margin="16,0,0,0"
                                VerticalAlignment="Top" Command="{Binding OpenLatestOnGitHubCommand}" />
                        <TextBlock Text="{Binding NotesTitle}" Style="{StaticResource SectionTitleText}" FontSize="17" TextWrapping="Wrap" />
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12" />
                    <FlowDocumentScrollViewer Style="{StaticResource NotesViewer}" Document="{Binding NotesDocument}"
                                              Visibility="{Binding IsMultiVersionNotes, Converter={StaticResource InverseBoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding ReleaseNotesSections}" Focusable="False" IsTabStop="False"
                                  Visibility="{Binding IsMultiVersionNotes, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReleaseNotesSectionViewModel}">
                                <StackPanel>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,14"
                                            Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVis}}" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource SmallDimText}" FontSize="12.5"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Visibility="{Binding HasDate, Converter={StaticResource BoolToVis}}" />
                                    </WrapPanel>
                                    <FlowDocumentScrollViewer Style="{StaticResource NotesViewer}" Document="{Binding Document}" Margin="0,6,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Sin datos aún -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasLatest, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Novedades" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding ReleasesEmptyText}" Style="{StaticResource DimText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- En desarrollo (hitos en curso del roadmap). Oculta si no hay datos. -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasRoadmapCurrent, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver roadmap" Margin="16,0,0,0"
                                VerticalAlignment="Center" Command="{Binding ShowRoadmapCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C1;" Style="{StaticResource GlyphText}" FontSize="15" Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="En desarrollo" Style="{StaticResource SectionTitleText}" FontSize="17" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RoadmapCurrent}" Focusable="False" IsTabStop="False" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RoadmapItemViewModel}">
                                <StackPanel Margin="0,12,0,0" AutomationProperties.Name="{Binding AutomationName}">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource SmallDimText}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Badge}" Background="#265AA9FF"
                                                    Visibility="{Binding IsNext, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Siguiente" Style="{StaticResource BadgeText}" Foreground="{StaticResource InfoBrush}" />
                                            </Border>
                                        </WrapPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource DimText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" ToolTip="{Binding Summary}"
                                               Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />
                                    <ProgressBar Margin="0,8,0,0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                                 AutomationProperties.Name="{Binding ProgressText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
