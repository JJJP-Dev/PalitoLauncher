<UserControl x:Class="PalitoLauncher.Views.RoadmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PalitoLauncher.ViewModels"
             Focusable="False">
    <UserControl.Resources>
        <!-- Icono de estado de cada hito: ✓ verde (completado), círculo ámbar (en curso), círculo azul (siguiente), punto tenue -->
        <DataTemplate x:Key="StatusIcon" DataType="{x:Type vm:RoadmapItemViewModel}">
            <Grid Width="24" Height="24">
                <Grid Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                    <Ellipse Fill="{StaticResource SuccessBrush}" />
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource BgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <Grid Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVis}}">
                    <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" />
                </Grid>
                <Ellipse Stroke="{StaticResource InfoBrush}" StrokeThickness="2"
                         Visibility="{Binding IsNext, Converter={StaticResource BoolToVis}}" />
                <Ellipse Width="8" Height="8" Fill="{StaticResource TextDimBrush}" Opacity="0.55"
                         Visibility="{Binding IsPlanned, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- Segmento de la barra global de hitos -->
        <Style x:Key="SegmentStyle" TargetType="Border">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNext}" Value="True">
                    <Setter Property="Background" Value="#805AA9FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="40,30,40,28" MaxWidth="980" HorizontalAlignment="Stretch">

            <!-- Cabecera -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding GameName, StringFormat=Roadmap de {0}}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Así avanza el desarrollo, según los milestones de GitHub." Style="{StaticResource DimText}"
                               Margin="2,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Margin="8,4,0,4" Command="{Binding RefreshRoadmapCommand}" AutomationProperties.Name="Actualizar roadmap"
                                ToolTip="Volver a consultar GitHub">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource GlyphText}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Actualizar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,4,0,4" Command="{Binding OpenRoadmapOnGitHubCommand}" AutomationProperties.Name="Ver milestones en GitHub">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource GlyphText}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Ver en GitHub" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0"
                                Visibility="{Binding RoadmapStatusText, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource GlyphText}" FontSize="12" Foreground="{StaticResource WarningBrush}"
                                   Margin="0,1,6,0" VerticalAlignment="Top"
                                   Visibility="{Binding IsRoadmapStale, Converter={StaticResource BoolToVis}}" />
                        <!-- Con datos guardados muestra el aviso de GitHub (puede ser largo: se parte en líneas) -->
                        <TextBlock Text="{Binding RoadmapStatusText}" FontSize="12.5" MaxWidth="340" TextWrapping="Wrap" TextAlignment="Right"
                                   AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoadmapStale}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Cargando -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding IsRoadmapLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Cargando el roadmap…" Style="{StaticResource DimText}" FontSize="14" />
                    <ProgressBar IsIndeterminate="True" Width="220" HorizontalAlignment="Left" Margin="0,12,0,0"
                                 AutomationProperties.Name="Cargando el roadmap" />
                </StackPanel>
            </Border>

            <!-- Sin datos -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding IsRoadmapFailed, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource GlyphText}" FontSize="16" Foreground="{StaticResource WarningBrush}"
                               Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding RoadmapFailedText}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Margin="16,0,0,0" Content="Reintentar" Command="{Binding RefreshRoadmapCommand}"
                            AutomationProperties.Name="Reintentar cargar el roadmap" />
                </Grid>
            </Border>

            <!-- Sin milestones -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding IsRoadmapEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Este proyecto aún no tiene milestones en GitHub." Style="{StaticResource DimText}" FontSize="14" />
            </Border>

            <!-- Resumen: hitos completados + barra global segmentada -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasRoadmapItems, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Completado" Style="{StaticResource SmallDimText}" Margin="6,0,14,0" VerticalAlignment="Center" />
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="En curso" Style="{StaticResource SmallDimText}" Margin="6,0,14,0" VerticalAlignment="Center" />
                            <Ellipse Width="8" Height="8" Fill="#805AA9FF" VerticalAlignment="Center" />
                            <TextBlock Text="Siguiente" Style="{StaticResource SmallDimText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding RoadmapSummaryText}" Style="{StaticResource SectionTitleText}" FontSize="17" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RoadmapItems}" Margin="0,14,0,0" Focusable="False" IsTabStop="False"
                                  AutomationProperties.Name="{Binding RoadmapSummaryText}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RoadmapItemViewModel}">
                                <Border Style="{StaticResource SegmentStyle}" ToolTip="{Binding SegmentToolTip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Fases con sus hitos -->
            <ItemsControl ItemsSource="{Binding RoadmapPhases}" Focusable="False" IsTabStop="False"
                          Visibility="{Binding HasRoadmapItems, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RoadmapPhaseViewModel}">
                        <StackPanel Margin="0,22,0,0">
                            <DockPanel Margin="2,0,2,10" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource SmallDimText}"
                                           VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RoadmapItemViewModel}">
                                            <StackPanel AutomationProperties.Name="{Binding AutomationName}">
                                                <Border Height="1" Background="{StaticResource BorderBrush}"
                                                        Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVis}}" />
                                                <Grid Margin="16,14,16,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusIcon}"
                                                                      VerticalAlignment="Top" Margin="0,1,14,0" />

                                                    <StackPanel Grid.Column="1" Background="Transparent" Cursor="Hand">
                                                        <StackPanel.InputBindings>
                                                            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleExpandedCommand}" />
                                                        </StackPanel.InputBindings>
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPlanned}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Border Style="{StaticResource Badge}" Background="{StaticResource SubtleAccentBrush}"
                                                                    Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="En curso" Style="{StaticResource BadgeText}" Foreground="{StaticResource AccentBrush}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Badge}" Background="#265AA9FF"
                                                                    Visibility="{Binding IsNext, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Siguiente" Style="{StaticResource BadgeText}" Foreground="{StaticResource InfoBrush}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource DimText}" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" MaxHeight="36" ToolTip="{Binding Summary}"
                                                                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />
                                                        <!-- Barra (como mucho 360 px, a la izquierda) y "14 de 25 tareas · 56 %" al lado -->
                                                        <Grid Margin="0,9,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MaxWidth="360" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ProgressBar Height="5" Maximum="100" VerticalAlignment="Center"
                                                                         Value="{Binding ProgressValue, Mode=OneWay}"
                                                                         AutomationProperties.Name="{Binding ProgressText}">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource SmallDimText}"
                                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <ToggleButton Grid.Column="2" Style="{StaticResource ChevronToggle}" VerticalAlignment="Top" Margin="12,0,0,0"
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  AutomationProperties.Name="Ver la descripción del hito" ToolTip="Ver más" />
                                                </Grid>

                                                <!-- Descripción completa -->
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="54,12,24,16"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <FlowDocumentScrollViewer Style="{StaticResource NotesViewer}" Document="{Binding DescriptionDocument}" />
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <TextBlock Text="{Binding DatesText}" Style="{StaticResource SmallDimText}" VerticalAlignment="Center"
                                                                       Margin="0,0,16,0" Visibility="{Binding HasDates, Converter={StaticResource BoolToVis}}" />
                                                            <Button Style="{StaticResource LinkButton}" Content="Ver en GitHub" VerticalAlignment="Center"
                                                                    Command="{Binding OpenOnGitHubCommand}"
                                                                    Visibility="{Binding CanOpenOnGitHub, Converter={StaticResource BoolToVis}}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
