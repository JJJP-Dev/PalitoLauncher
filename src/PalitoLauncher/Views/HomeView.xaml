<UserControl x:Class="PalitoLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="40,30,40,28" MaxWidth="980" HorizontalAlignment="Stretch">

            <TextBlock Text="{Binding GameName}" FontSize="46" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Instala, actualiza y juega con tus amigos." Style="{StaticResource DimText}" FontSize="14" Margin="2,2,0,0" />

            <!-- Chips -->
            <WrapPanel Margin="0,18,0,0">
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphText}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding InstalledVersionText}" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Visibility="{Binding HasLatest, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource GlyphText}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LatestVersionText}" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge}" Background="{StaticResource AccentBrush}"
                                Visibility="{Binding IsLatestNew, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nuevo" Style="{StaticResource BadgeText}" Foreground="{StaticResource OnAccentBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" BorderBrush="#55FFB020" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource GlyphText}" FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding OfflineChipText}" FontSize="13" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Novedades de la última versión -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasLatest, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver en GitHub" Margin="16,0,0,0"
                                VerticalAlignment="Center" Command="{Binding OpenLatestOnGitHubCommand}" />
                        <TextBlock Text="{Binding NotesTitle}" Style="{StaticResource SectionTitleText}" FontSize="17" />
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12" />
                    <FlowDocumentScrollViewer Style="{StaticResource NotesViewer}" Document="{Binding NotesDocument}" />
                </StackPanel>
            </Border>

            <!-- Sin datos aún -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasLatest, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Novedades" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding ReleasesEmptyText}" Style="{StaticResource DimText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
