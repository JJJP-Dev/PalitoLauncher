<UserControl x:Class="PalitoLauncher.Views.AnnouncementBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PalitoLauncher.ViewModels"
             Focusable="False">
    <!-- DataContext: MainViewModel. Cada anuncio es una franja como el banner del launcher, del color de su nivel. -->
    <UserControl.Resources>
        <Style x:Key="AnnouncementBanner" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InfoBannerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="24,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NoticeKind.Warning}">
                    <Setter Property="Background" Value="{StaticResource WarningBannerBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NoticeKind.Error}">
                    <Setter Property="Background" Value="{StaticResource DangerBannerBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AnnouncementGlyph" TargetType="TextBlock" BasedOn="{StaticResource GlyphText}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NoticeKind.Warning}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NoticeKind.Error}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Announcements}" Focusable="False" IsTabStop="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:AnnouncementViewModel}">
                <Border Style="{StaticResource AnnouncementBanner}"
                        AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.LiveSetting="Polite">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource AnnouncementGlyph}" VerticalAlignment="Top"
                                   Margin="0,2,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource DimText}" Margin="0,2,0,0"
                                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="10" Margin="6,0,-8,0"
                                    Content="&#xE711;" Command="{Binding DismissCommand}"
                                    ToolTip="No volver a mostrar" AutomationProperties.Name="Cerrar anuncio"
                                    Visibility="{Binding IsDismissible, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
