<UserControl x:Class="PalitoLauncher.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PalitoLauncher.ViewModels"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="40,30,40,28" MaxWidth="980" HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Versiones" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{Binding ReleasesInfoText}" Style="{StaticResource DimText}" Margin="2,4,0,0"
                               Visibility="{Binding ReleasesInfoText, Converter={StaticResource NullToVis}}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Margin="8,4,0,4" Command="{Binding RefreshReleasesCommand}" AutomationProperties.Name="Actualizar lista">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource GlyphText}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Actualizar lista" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,4,0,4" Command="{Binding OpenGameReleasesPageCommand}" AutomationProperties.Name="Abrir releases en GitHub">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource GlyphText}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Abrir releases en GitHub" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Releases}" Margin="0,18,0,0" Focusable="False"
                          Visibility="{Binding HasReleases, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ReleaseItemViewModel}">
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="14,14,20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton Style="{StaticResource ChevronToggle}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="Ver notas de la versión" ToolTip="Ver notas" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleExpandedCommand}" />
                                        </StackPanel.InputBindings>
                                        <WrapPanel>
                                            <TextBlock Text="{Binding VersionText}" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Badge}" Background="#263DDC97"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Instalada" Style="{StaticResource BadgeText}" Foreground="{StaticResource SuccessBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource SubtleAccentBrush}"
                                                    Visibility="{Binding IsLatest, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Última" Style="{StaticResource BadgeText}" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="#265AA9FF"
                                                    Visibility="{Binding IsPrerelease, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="De prueba" Style="{StaticResource BadgeText}" Foreground="{StaticResource InfoBrush}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding DetailsText}" Style="{StaticResource DimText}" Margin="0,3,0,0"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Style="{StaticResource LinkButton}" Content="Ver en GitHub" VerticalAlignment="Center"
                                                Command="{Binding OpenOnGitHubCommand}" Margin="0,0,14,0" />
                                        <Button Content="Instalar esta versión" Command="{Binding InstallCommand}"
                                                Visibility="{Binding CanShowInstall, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>

                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="56,14,24,18"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <FlowDocumentScrollViewer Style="{StaticResource NotesViewer}" Document="{Binding NotesDocument}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasReleases, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="{Binding ReleasesEmptyText}" Style="{StaticResource DimText}" FontSize="14" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
