# --- Palito Launcher ---
# Launcher antiguo (WPF .NET 8 + Google Cloud Functions): se conserva solo en local como referencia.
_legacy/

# Salida de scripts/publish.ps1 y del workflow de release.
publish/

# Carpetas de artefactos (dotnet build --artifacts-path).
artifacts/
artifacts_*/

